# ==========================================================================
#  PSI Top · backend Siemens — configuración
#  Copia este archivo como `.env` y ajusta los valores. Prefijo: PLC_
#  Todo lo comentado muestra su valor por defecto.
# ==========================================================================

# --- Servidor web -----------------------------------------------------------
# PLC_API_HOST=0.0.0.0
# PLC_API_PORT=8000
# PLC_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
# Orígenes CORS permitidos (JSON). ["*"] = cualquiera (desarrollo).
# PLC_CORS_ORIGINS=["http://localhost:5173","http://10.0.0.5"]

# Clave de API para TODO lo que modifica algo (alta/baja de PLC, escritura,
# lista blanca). Vacía = sin protección. En planta ponla SIEMPRE.
# Se manda en la cabecera `X-API-Key` (REST) o `?api_key=` (WebSocket).
# PLC_API_KEY=cambia-esta-clave

# Carpeta donde se persiste el estado. Vacío = <raíz del proyecto>/datos.
# PLC_DATOS_DIR=C:\ProgramData\PsiTop\datos

# --- Arranque ---------------------------------------------------------------
# Los PLCs guardados en datos/plcs.json se conectan SIEMPRE al arrancar.
# Con autostart=true además se conectan los PLC_STATIC_ENDPOINTS y, si
# discovery_enabled=true, se escanea la subred.
# PLC_AUTOSTART_PLCS=false
# PLC_STATIC_ENDPOINTS=["opc.tcp://192.168.0.10:4840","s7://192.168.0.20:102/0/1"]
# PLC_DISCOVERY_ENABLED=false
# PLC_DISCOVERY_SUBNET=192.168.0.0/24
# PLC_DISCOVERY_INTERVAL=0                # segundos entre re-escaneos; 0 = nunca

# --- Siemens: transporte por defecto ---------------------------------------
#   opcua   -> S7-1500 / S7-1200 FW>=4.4 con servidor OPC UA activado
#   s7comm  -> S7-1200 (cualquier FW), S7-300/400, ET 200SP (puerto 102)
# Cada PLC puede traer el suyo en POST /plcs; esto solo es el defecto.
# PLC_SIEMENS_TRANSPORTE=opcua

# --- OPC UA -----------------------------------------------------------------
# PLC_OPCUA_ENDPOINT=opc.tcp://192.168.0.1:4840   # semilla (solo para derivar la subred)
# PLC_OPCUA_CONNECT_TIMEOUT=8.0           # al abrir la sesión
# PLC_OPCUA_REQUEST_TIMEOUT=4.0           # por petición: acota la detección de caídas
# PLC_BROWSE_PLC_NAME=PLC_1              # si no coincide, se busca DataBlocksGlobal en todos
# PLC_PUBLISHING_INTERVAL_MS=500
# PLC_SAMPLING_INTERVAL_MS=1000          # mínimo 100 ms en S7-1500, 1000 ms en S7-1200
# PLC_SUBSCRIPTION_QUEUE_SIZE=10
# Solo descubrir estos DB (JSON). Vacío = todos. También app/config/tags_filter.yaml
# PLC_TAGS_FILTER_DBS=["DB_Datos","DB_Recetas"]
# Autenticación OPC UA (por defecto anónima):
# PLC_OPCUA_USERNAME=
# PLC_OPCUA_PASSWORD=
# Seguridad OPC UA (por defecto None):
# PLC_SECURITY_POLICY=Basic256Sha256
# PLC_SECURITY_MODE=SignAndEncrypt
# PLC_CLIENT_CERT_PATH=C:\certs\client_cert.pem
# PLC_CLIENT_PRIVATE_KEY_PATH=C:\certs\client_key.pem

# --- S7comm (python-snap7) --------------------------------------------------
# PLC_S7_RACK=0
# PLC_S7_SLOT=1                          # 1 en S7-1200/1500, 2 en S7-300
# PLC_S7_CONNECT_TIMEOUT=5.0
# PLC_S7_POLL_INTERVAL_MS=250            # S7comm no tiene subscription: siempre polling
# Lista de tags por defecto (solo para PLC_STATIC_ENDPOINTS s7://). Una por
# línea; en el .env se separan con \n:
# PLC_S7_TAGS=temperatura;DB1;0;REAL\nmarcha;DB1;4.0;BOOL
#
# EN TIA PORTAL, o no lee nada: (1) CPU -> Protección y seguridad -> marcar
# "Permitir acceso vía comunicación PUT/GET"; (2) en cada DB, DESMARCAR
# "Acceso optimizado al bloque"; (3) compilar y cargar.

# --- Reconexión y watchdog --------------------------------------------------
# PLC_RECONNECT_INITIAL_DELAY=2.0
# PLC_RECONNECT_MAX_DELAY=30.0
# PLC_RECONNECT_BACKOFF_FACTOR=2.0
# PLC_HEALTHCHECK_INTERVAL=5.0           # cada cuánto se comprueba la sesión y se reconcilia
